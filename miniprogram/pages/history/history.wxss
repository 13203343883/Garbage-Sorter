/**history.wxss**/
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #f5f5f5;
}

.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

.header { position: relative;
  width: 100%;
  padding: 24rpx 0;
  background-color: #07C160;
  text-align: center;
  flex-shrink: 0;
}

.header-title {
  color: #ffffff;
  font-size: 36rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.empty-tip {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-bottom: 120rpx;
}

.empty-icon {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 24rpx;
  background-color: #e0e0e0;
  border-radius: 50%;
}

.empty-text {
  font-size: 28rpx;
  color: #999999;
}

.history-list {
  flex: 1;
  padding: 16rpx 24rpx;
}

.history-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 28rpx 24rpx;
  margin-bottom: 16rpx;
  background-color: #ffffff;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.history-item-active {
  background-color: #f5f5f5;
}

.item-name {
  font-size: 30rpx;
  color: #333333;
  font-weight: 500;
  flex-shrink: 0;
  max-width: 200rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-category {
  margin-left: 20rpx;
  padding: 6rpx 20rpx;
  font-size: 24rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
}

.category-recyclable {
  background-color: rgba(7, 193, 96, 0.12);
  color: #07C160;
}

.category-hazardous {
  background-color: rgba(231, 76, 60, 0.12);
  color: #E74C3C;
}

.category-kitchen {
  background-color: rgba(243, 156, 18, 0.12);
  color: #F39C12;
}

.category-other {
  background-color: rgba(149, 165, 166, 0.15);
  color: #7F8C8D;
}

.item-time {
  margin-left: 24rpx;
  font-size: 24rpx;
  color: #aaaaaa;
  flex-shrink: 0;
}
.clear-btn { position: absolute; right: 24rpx; top: 50%; transform: translateY(-50%); color: #ffffff; font-size: 26rpx; }
