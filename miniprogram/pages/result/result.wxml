<!--result.wxml-->
<view class="page">
  <view class="header">
    <text class="header-title">识别结果</text>
  </view>

  <view wx:if="{{imagePath}}" class="image-area">
    <image class="result-image" src="{{imagePath}}" mode="widthFix"></image>
  </view>
  <view wx:else class="image-area image-empty">
    <text class="empty-hint">暂无图片</text>
  </view>

  <view class="demo-banner" wx:if="{{!isReal}}"><text>⚠ 演示数据，非真实识别结果</text></view><view class="info-card">
    <view class="info-row">
      <text class="info-label">垃圾名称</text>
      <text class="info-value">{{garbageName || '—'}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">垃圾类别</text>
      <text class="info-value category-tag category-{{categoryClass}}">{{garbageCategory || '—'}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">置信度</text>
      <text class="info-value">{{confidence ? confidence + '%' : '—'}}</text>
    </view>
  </view>

  <view class="button-area">
    <button class="btn-again" bindtap="goAgain">再来一次</button>
  </view>
</view>