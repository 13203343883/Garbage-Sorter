/**index.wxss**/
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #f5f5f5;
}

.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

.header {
  width: 100%;
  padding: 24rpx 0;
  background-color: #07C160;
  text-align: center;
  flex-shrink: 0;
}

.header-title {
  color: #ffffff;
  font-size: 36rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.guide-section {
  flex: 1;
  display: flex;
  flex-direction: column;
  margin: 16rpx 24rpx 0;
  min-height: 0;
}

.guide-title {
  font-size: 26rpx;
  color: #999999;
  margin-bottom: 12rpx;
  display: block;
  flex-shrink: 0;
}

.guide-grid {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.guide-item {
  width: 100%;
  display: flex;
  flex-direction: column;
  justify-content: center;
  background-color: #ffffff;
  border-radius: 12rpx;
  padding: 24rpx 20rpx;
  box-sizing: border-box;
}

.guide-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-bottom: 10rpx;
}

.dot-recyclable { background-color: #07C160; }
.dot-hazardous { background-color: #E74C3C; }
.dot-kitchen { background-color: #F39C12; }
.dot-other { background-color: #7F8C8D; }

.guide-label {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 4rpx;
}

.guide-desc {
  font-size: 22rpx;
  color: #aaaaaa;
}

.preview-area {
  flex-shrink: 0;
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 12rpx 24rpx;
  background-color: #ffffff;
  border-radius: 16rpx;
  border: 2rpx dashed #d0d0d0;
  overflow: hidden;
}

.preview-image {
  width: 100%;
  height: 100%;
}

.preview-placeholder {
  color: #999999;
  font-size: 28rpx;
}

.result-area {
  margin: 0 24rpx 12rpx;
  padding: 20rpx;
  background-color: #ffffff;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.result-text {
  font-size: 28rpx;
  color: #333333;
  text-align: center;
}

.button-group {
  display: flex;
  flex-direction: row;
  padding: 12rpx 24rpx;
  padding-bottom: calc(12rpx + 100rpx + env(safe-area-inset-bottom));
  gap: 24rpx;
  flex-shrink: 0;
}

.btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 500;
  border: none;
  padding: 0;
}

.btn::after {
  border: none;
}

.btn-camera {
  background-color: #07C160;
  color: #ffffff;
}

.btn-album {
  background-color: #ffffff;
  color: #07C160;
  border: 2rpx solid #07C160;
}