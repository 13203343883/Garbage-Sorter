/**index.wxss**/
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #f5f5f5;
}

.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

/* 顶部标题栏 */
.header {
  width: 100%;
  padding: 32rpx 0;
  background-color: #07C160;
  text-align: center;
  flex-shrink: 0;
}

.header-title {
  color: #ffffff;
  font-size: 36rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

/* 图片预览区域 */
.preview-area {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 32rpx;
  background-color: #ffffff;
  border-radius: 16rpx;
  border: 2rpx dashed #d0d0d0;
  overflow: hidden;
}

.preview-image {
  width: 100%;
  height: 100%;
}

.preview-placeholder {
  color: #999999;
  font-size: 28rpx;
}

/* 识别结果区域 */
.result-area {
  margin: 0 32rpx 24rpx;
  padding: 24rpx;
  background-color: #ffffff;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.result-text {
  font-size: 28rpx;
  color: #333333;
  text-align: center;
}

/* 底部按钮组 */
.button-group {
  display: flex;
  flex-direction: row;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  gap: 24rpx;
  flex-shrink: 0;
}

.btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 500;
  border: none;
  padding: 0;
}

.btn::after {
  border: none;
}

.btn-camera {
  background-color: #07C160;
  color: #ffffff;
}

.btn-album {
  background-color: #ffffff;
  color: #07C160;
  border: 2rpx solid #07C160;
}