<!--index.wxml-->
<view class="page">
  <view class="header">
    <text class="header-title">垃圾分类助手</text>
  </view>

  <!-- 分类指南 -->
  <view wx:if="{{showGuide}}" class="guide-section">
    <text class="guide-title">垃圾分类指南</text>
    <view class="guide-grid">
      <view class="guide-item">
        <view class="guide-dot dot-recyclable"></view>
        <text class="guide-label" style="color: #07C160;">可回收物</text>
        <text class="guide-desc">纸类、塑料、金属、玻璃</text>
      </view>
      <view class="guide-item">
        <view class="guide-dot dot-hazardous"></view>
        <text class="guide-label" style="color: #E74C3C;">有害垃圾</text>
        <text class="guide-desc">电池、灯管、药品、油漆</text>
      </view>
      <view class="guide-item">
        <view class="guide-dot dot-kitchen"></view>
        <text class="guide-label" style="color: #F39C12;">厨余垃圾</text>
        <text class="guide-desc">剩饭、果皮、茶叶、花卉</text>
      </view>
      <view class="guide-item">
        <view class="guide-dot dot-other"></view>
        <text class="guide-label" style="color: #7F8C8D;">其他垃圾</text>
        <text class="guide-desc">纸巾、尘土、一次性餐具</text>
      </view>
    </view>
  </view>

  <!-- 图片预览区域 -->
  <view class="preview-area">
    <image wx:if="{{hasImage}}" class="preview-image" src="{{imagePath}}" mode="aspectFit"></image>
    <text wx:else class="preview-placeholder">请点击下方按钮选择图片</text>
  </view>

  <view wx:if="{{hasImage}}" class="result-area">
    <text class="result-text">{{result || '等待识别...'}}</text>
  </view>

  <view class="button-group">
    <button class="btn btn-camera" bindtap="takePhoto">
      <text>📷 拍照识别</text>
    </button>
    <button class="btn btn-album" bindtap="chooseFromAlbum">
      <text>🖼 从相册选择</text>
    </button>
  </view>
</view>