/* custom-tab-bar/index.wxss */
.tab-bar {
  display: flex;
  flex-direction: row;
  height: 100rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background-color: #ffffff;
  border-top: 1rpx solid #e5e5e5;
}

.tab-bar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.tab-icon {
  font-size: 40rpx;
  line-height: 44rpx;
}

.tab-text {
  font-size: 28rpx;
  color: #999999;
  margin-top: 4rpx;
}

.tab-text.active {
  color: #07C160;
  font-weight: 600;
}